CAPI=2:
name: socet:aft:gpio:0.1.0
description: Digital I/O controller module with up to 32 pins

filesets:
    rtl:
        depend:
            - "socet:digital-lib:edge_detector"
            - "socet:bus-components:bus_protocol_if"
        files:
            - src/gpio.sv
            - src/gpio_if.sv
        file_type: systemVerilogSource

    tb:
        files:
            - tb/tb_gpio.sv
            - tb/gpio_wrapper.sv
        file_type: systemVerilogSource

    verilator_tb:
        files:
            - tb/gpio_wrapper.sv
            - tb/tb_gpio.cc : { file_type: cppSource }
        file_type: systemVerilogSource

    lint_files:
        files:
            - src/gpio.sv
            - tb/tb_gpio.sv
            - tb/gpio_wrapper.sv
            - include/gpio_if.vh : {is_include_file: true}
        file_type: systemVerilogSource


targets:
    default: &default
        filesets:
            - rtl
        toplevel: gpio
    
    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb)"
            - "tool_verilator? (verilator_tb)"
        parameters:
            - NUM_PINS=8
        toplevel: 
            - "tool_verilator? (gpio_wrapper)"
            - "!tool_verilator? (tb_gpio)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs

    fpga:
        <<: *default
        description: Synthesize for FPGA
        default_tool: quartus
        toplevel:
            - gpio
        parameters:
            - NUM_PINS=8
            - SYNTHESIS=true
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7 
                

    lint:
        filesets:
            - lint_files
        description: Linting
        default_tool: veriblelint
        toplevel: tb_gpio
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

    format:
        filesets:
            - lint_files
        description: Formatting
        default_tool: veribleformat
        toplevel: tb_gpio
        tools:
            veribleformat:
                verible_format_args: ['--indentation_spaces=4', '--inplace']

parameters:
    NUM_PINS:
        datatype: int
        description: Number of pins, 1 <= NUM_PINS <= 32
        paramtype: vlogparam
    SYNTHESIS:
        datatype: bool
        paramtype: vlogdefine
