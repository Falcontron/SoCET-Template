CAPI=2:
name: socet:aft:ff_ram:0.0.1
description: Scratchpad flip-flop RAM for testing

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if"
        files:
            - src/ff_ram.sv
            - src/ram.v
        file_type: systemVerilogSource

    tb:
        files:
            - tb/tb_ff_ram.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: ff_ram

    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "!tool_verilator? (tb)"
            - "tool_verilator? (verilator_tb)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs
