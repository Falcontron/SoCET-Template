CAPI=2:
name: socet:aft:pwm:0.1.1
description: PWM Module with parameterizable number of channels

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if"
        files:
            - source/flex_counter.sv
            - source/pwmchannel.sv
            - source/pwm_wrapper.sv
        file_type: systemVerilogSource

    tb:
        files:
            - testbench/tb_pwm_wrapper.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: pwm
    
    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: xcelium 
        filesets_append:
            - tb
        toplevel: 
            - "!tool_verilator? (tb_pwm_wrapper)"
            - "tool_verilator? (pwm_wrapper)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs

    fpga:
        <<: *default
        description: Synthesize for FPGA
        default_tool: quartus
        toplevel:
            - pwm
        parameters:
            - NUM_PINS=8
            - SYNTHESIS=true
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7 
                

    lint:
        filesets:
            - lint_files
        description: Linting
        default_tool: veriblelint
        toplevel: tb_pwm
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

    format:
        filesets:
            - lint_files
        description: Formatting
        default_tool: veribleformat
        toplevel: tb_pwm
        tools:
            veribleformat:
                verible_format_args: ['--indentation_spaces=4', '--inplace']

parameters:
    SYNTHESIS:
        datatype: bool
        paramtype: vlogdefine
