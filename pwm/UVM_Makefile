TOP = uvm_tb/pwm_top.sv
TEST = uvm_tb/

all: build run

build: 
	vlog +incdir+source \
	+incdir+include \
	+incdir+$(TEST) \
	+acc \
	+cover \
	-L /package/eda/mg/questa10.6b/questasim/uvm-1.2 $(TOP) 

run:
	vsim -i tb_pwm -L \
	/package/eda/mg/questa10.6b/questasim/uvm-1.2 \
	-voptargs=+acc \
	-coverage \
	+UVM_TESTNAME="pwm_test" \
	+UVM_VERBOSITY=UVM_LOW \
	-do "do wave.do" -do "run -all"

clean:
	rm -rf work
	rm -rf mitll90_Dec2019_all
	rm -rf covhtmlreport
	rm *.log
	rm transcript
	rm *.wlf
