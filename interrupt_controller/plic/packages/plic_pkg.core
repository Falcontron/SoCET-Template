CAPI=2:
name: socet:aft:plic_pkg:0.1.0
description: Package for types used by the PLIC

filesets:
    rtl:
        files:
            - plic_pkg.sv: {is_include_file: true}
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
    lint:
        filesets:
            - rtl
        description: Linting
        default_tool: veriblelint
        toplevel: plic_pkg
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']
