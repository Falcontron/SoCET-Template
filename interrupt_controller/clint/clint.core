CAPI=2:
name: socet:aft:clint:0.1.0
description: RISC-V Core Local Interrupt Controller (CLINT)

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if"
        files:
            - src/clint_if.sv
            - src/clint.sv
        file_type: systemVerilogSource

    verilator_tb:
        files:
            - tb/clint_wrapper.sv
            - tb/tb_clint.cc : { file_type: cppSource }
        file_type: systemVerilogSource

    lint_files:
        files:
            - src/clint_if.sv
            - src/clint.sv
            - tb/clint_wrapper.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: clint

    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: verilator
        filesets_append:
            - "tool_verilator? (verilator_tb)"
        toplevel:
            - "tool_verilator? (clint_wrapper)"
        tools:
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs
                    - -GNUM_HARTS=2
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7

    lint:
        filesets:
            - lint_files
        description: Linting
        default_tool: veriblelint
        toplevel:
            - "!tool_verilator? (clint)"
            - "tool_verilator? (clint_wrapper)"
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']
