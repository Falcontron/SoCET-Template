CAPI=2:
name: socet:aft:sram_sim:0.1.0
description: sram chip timing simulation

filesets:
    rtl:
        files:
            - src/sram_sim.sv
            - src/io_pad.sv
        file_type: systemVerilogSource

    tb:
        files:
            - tb/tb_sram_sim.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: sram_sim
    
    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: xcelium 
        filesets_append:
            - tb
        toplevel: 
            - "!tool_verilator? (tb_sram_sim)"
            - "tool_verilator? (sram_sim)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps 
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs

    fpga:
        <<: *default
        description: Synthesize for FPGA
        default_tool: quartus
        toplevel:
            - sram_controller
        parameters:
            - NUM_PINS=8
            - SYNTHESIS=true
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7 
                

    lint:
        filesets:
            - lint_files
        description: Linting
        default_tool: veriblelint
        toplevel: tb_sram_sim
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

    format:
        filesets:
            - lint_files
        description: Formatting
        default_tool: veribleformat
        toplevel: tb_sram_sim
        tools:
            veribleformat:
                verible_format_args: ['--indentation_spaces=4', '--inplace']

parameters:
    SYNTHESIS:
        datatype: bool
        paramtype: vlogdefine
