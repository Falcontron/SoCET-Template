CAPI=2:
name: socet:bus-components:simple_memory:0.1.3
description: Simple memory using bus_protocol_if for testing bus managers

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if"
        files:
            - simple_memory.sv
        file_type: systemVerilogSource


targets:
    default:
        filesets:
            - rtl
        toplevel: simple_memory
