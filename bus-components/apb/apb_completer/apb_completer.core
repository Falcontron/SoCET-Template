CAPI=2:
name: socet:bus-components:apb_completer:0.0.3
description: Parameterizable APB Completer (AMBA 5)

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if"
            - "socet:bus-components:apb_if"
        files:
            - src/apb_completer.sv
        file_type: systemVerilogSource


    tb:
        depend:
            - "socet:bus-components:simple_memory"
        files:
            - tb/tb_apb_completer.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: apb_completer


    sim:
        <<: *default
        filesets_append:
            - tb
        description: Simulate w/TB
        default_tool: xcelium
        toplevel: tb_apb_completer
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps

    lint:
        filesets:
            - rtl
            - tb
        description: Linting
        default_tool: veriblelint
        toplevel: tb_apb_completer
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

