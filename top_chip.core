CAPI=2:
name: socet:aft:top_chip:0.1.0
description: AFTx07 SoC

filesets:
    rtl:
        depend:
            - "socet:aft:aftx07_wrapper"
    
        files:
            - ./../top_chip.v
            - ./../PLL_TOP.sv
            - ./../top_chip_simcells.v
            - ./../../../memory-lib/compout/views/sram_4k/Typical/sram_4k.v
            - /package/asicfab/pdk/tsmc/tsmc180/io/tpz018nv_280c/TSMCHOME/digital/Front_End/verilog/tpz018nv_270a/tpz018nv.v
        file_type: systemVerilogSource

    rtl_append:
        depend:
            - "socet:aft:sram_sim"
        file_type: systemVerilogSource

    tb:
        files:
            - top_level/tb/tb_top_chip.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: top_chip
    
    syn:
        filesets:
            - rtl
        description: Prepare for Synthesis
        default_tool: xcelium
        toplevel: top_chip
    
    sim:
        <<: *default
        description: Simulate with TB
        default_tool: modelsim
        filesets_append:
            - rtl_append
            - "!tool_verilator? (tb)"
            - "tool_verilator? (verilator_tb)"
        
        toplevel:
            - "tool_verilator? (top_chip)"
            - "!tool_verilator? (tb_top_chip)"
        tools:
            modelsim:
                vlog_options:
                    - -suppress 7061
                vsim_options:
                    - -vopt
                    #- -voptargs='+acc'
                    - -t ps
           
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            vcs:
                vcs_options:
                    - -full64
                    - -assert svaext
                    - -timescale=1ns/100ps
                    - -debug_access+all    
                    - -kdb
                    - -ignore initializer_driver_checks
                    - +define+SRAM
                    - +define+NOIP
                    - +define+SYNTHESIS
                    - +lint=TFIPC-L
            
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs
                    #- -Wno-IMPLICIT
                    - -Wno-lint
                    - -Wno-SYMRSVDWORD
                    - -Wno-TIMESCALEMOD
                    - -Wno-UNPACKED
                make_options:
                    - -j

    lint:
        filesets:
            - rtl
            - tb
        description: Lint with Verible
        default_tool: veriblelint
        toplevel: tb_top_chip
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']