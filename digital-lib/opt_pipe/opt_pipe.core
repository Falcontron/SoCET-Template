CAPI=2:
name: socet:digital-lib:opt_pipe:0.0.1
description: Optional pipeline

filesets:
    rtl:
        files:
            - src/opt_pipe.sv
        file_type: systemVerilogSource

    tb:
        files:
            - tb/opt_pipe_tb.cc : {file_type: cppSource}
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: opt_pipe

    sim:
        <<: *default
        filesets:
            - rtl
            - tb
        description: Simulate w/TB
        default_tool: verilator
        tools:
            verilator:
                verilator_options:
                    - --assert
                    - -Wno-SYMRSVDWORD
                    - -Wno-ENUMVALUE
                    - -Wno-TIMESCALEMOD
                    - --trace
                    - --trace-fst
                    - --trace-structs
                    - -GWIDTH=8
                    - -GNUM_STAGES=2
