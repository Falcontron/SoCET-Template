CAPI=2:
name: socet:digital-lib:wt_mult_tb:0.0.1
description: Testbenches for generalized Wallace Tree multiplier

filesets:
  tb:
    depend:
      - socet:digital-lib:wt_mult:0.0.1
    files:
      - mul_test.cc : {file_type: cppSource}
    file_type: systemVerilogSource

targets:
  default: &default
    toplevel: wt_mult
    filesets:
      - tb
    default_tool: verilator
    tools:
      verilator:
        verilator_options:
          - --assert
          - -Wno-SYMRSVDWORD
          - -Wno-ENUMVALUE
          - -Wno-TIMESCALEMOD
          - -Wno-lint
          - --trace
          - --trace-fst
          - --trace-structs
          - --trace-threads 4
          - --threads 4
          - -GSTAGE_DEPTH=8
          - -GMERGE_PROD_GEN_REDUCE_STAGES=0
          - -GMERGE_REDUCE_FINAL_STAGES=0
          - -CFLAGS "-std=c++23 -DSTAGE_DEPTH=8 -DMERGE_PROD_GEN_REDUCE_STAGES=0 -DMERGE_REDUCE_FINAL_STAGES=0"

  tb_u4:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=4
          - -GSIGNED=0
          - -CFLAGS "-DWIDTH=4 -DSIGNED=0"

  tb_u8:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=8
          - -GSIGNED=0
          - -CFLAGS "-DWIDTH=8 -DSIGNED=0"

  tb_u16:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=16
          - -GSIGNED=0
          - -CFLAGS "-DWIDTH=16 -DSIGNED=0"

  tb_u24:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=24
          - -GSIGNED=0
          - -CFLAGS "-DWIDTH=24 -DSIGNED=0"

  tb_u32:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=32
          - -GSIGNED=0
          - -CFLAGS "-DWIDTH=32 -DSIGNED=0"

  tb_u53:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=53
          - -GSIGNED=0
          - -CFLAGS "-DWIDTH=53 -DSIGNED=0"

  tb_u64:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=64
          - -GSIGNED=0
          - -CFLAGS "-DWIDTH=64 -DSIGNED=0"

  tb_i4:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=4
          - -GSIGNED=1
          - -CFLAGS "-DWIDTH=4 -DSIGNED=1"

  tb_i8:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=8
          - -GSIGNED=1
          - -CFLAGS "-DWIDTH=8 -DSIGNED=1"

  tb_i16:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=16
          - -GSIGNED=1
          - -CFLAGS "-DWIDTH=16 -DSIGNED=1"

  tb_i24:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=24
          - -GSIGNED=1
          - -CFLAGS "-DWIDTH=24 -DSIGNED=1"

  tb_i32:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=32
          - -GSIGNED=1
          - -CFLAGS "-DWIDTH=32 -DSIGNED=1"

  tb_i53:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=53
          - -GSIGNED=1
          - -CFLAGS "-DWIDTH=53 -DSIGNED=1"

  tb_i64:
    <<: *default
    tools:
      verilator:
        verilator_options_append:
          - -GWIDTH=64
          - -GSIGNED=1
          - -CFLAGS "-DWIDTH=64 -DSIGNED=1"
