CAPI=2:
name: socet:aft:rom:0.1.0
description: bootloader ROM

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if"
        files:
            - rom.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: rom
