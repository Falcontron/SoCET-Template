CAPI=2:
name: socet:aft:aftx07_wrapper:0.2.0
description: AFTx07 SoC

filesets:
    rtl:
        depend:
            - "socet:digital-lib:synchronizer"
            - "socet:aft:aftx07"
    
        files:
            - top_level/src/aftx07_wrapper.sv
            - top_level/src/aftx07_macros.vh : { is_include_file : true }
        file_type: systemVerilogSource

    rtl_append:
        depend:
            - ">=socet:bus-components:simple_memory:0.1.3"
            - "socet:bus-components:mmio_printer"
            - "socet:aft:sram_sim"
        file_type: systemVerilogSource

    tb:
        files:
            - top_level/tb/tb_aftx07_wrapper.sv
        file_type: systemVerilogSource
    
    verilator_tb:
        files:
            - top_level/tb/tb_aftx07.cc : { file_type: cppSource }
        file_type: systemVerilogSource

    fpga:
        depend:
            - "socet:aft:io_pad"
        files:
            - fpga/aftx07_fpga.sv
            - fpga/pinmap.tcl : { file_type: tclSource }
        file_type: systemVerilogSource

    fpga_sram:
        depend:
            - "socet:aft:io_pad"
        files:
            - fpga/aftx07_fpga.sv
            - fpga/sram_pinmap.tcl : { file_type: tclSource }
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: aftx07
    
    syn:
        filesets:
            - rtl
        description: Prepare for Synthesis
        default_tool: xcelium
        parameters:
            - SYNTHESIS=true
            - NOIP=true
        toplevel: aftx07_wrapper
    
    sim:
        <<: *default
        description: Simulate with TB
        default_tool: modelsim
        filesets_append:
            - rtl_append
            - "!tool_verilator? (tb)"
            - "tool_verilator? (verilator_tb)"
        
        toplevel:
            - "tool_verilator? (aftx07_wrapper)"
            - "!tool_verilator? (tb_aftx07_wrapper)"
        tools:
            modelsim:
                vlog_options:
                    - -suppress 7061
                vsim_options:
                    - -vopt
                    #- -voptargs='+acc'
                    - -t ps
           
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            vcs:
                vcs_options:
                    - -full64
                    - -assert svaext
                    - -timescale=1ns/100ps
                    - -debug_access+all    
                    - -kdb
                    - -ignore initializer_driver_checks
                    # - +define+SRAM
                    - +define+NOIP
                    - +define+SYNTHESIS
                    - +lint=TFIPC-L
            
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs
                    #- -Wno-IMPLICIT
                    - -Wno-lint
                    - -Wno-SYMRSVDWORD
                    - -Wno-TIMESCALEMOD
                    - -Wno-UNPACKED
                make_options:
                    - -j

    fpga:
        filesets:
            - rtl
            - fpga
        description: FPGA Synthesis
        default_tool: quartus
        parameters:
            - SYNTHESIS=true
            - WRAPPER=true
            - QUARTUS=true
        toplevel: aftx07_fpga
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7

    fpga_sram:
        filesets:
            - rtl
            - fpga_sram
        description: FPGA Synthesis
        default_tool: quartus
        parameters:
            - SYNTHESIS=true
            - WRAPPER=true
            - QUARTUS=true
        toplevel: aftx07_fpga
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7

    lint:
        filesets:
            - rtl
            - tb
        description: Lint with Verible
        default_tool: veriblelint
        toplevel: tb_aftx07_wrapper
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

parameters:
    CLOCK_SPEED:
        datatype: int
        description: Clock speed (in MHz)
        paramtype: vlogparam
    
    INIT_FILE:
        datatype: file
        description: .bin file to initialize RAM
        paramtype: cmdlinearg

    SYNTHESIS:
        description: Set for tools performing synthesis
        datatype: bool
        paramtype: vlogdefine
    
    WRAPPER:
        description: Set to use aftx07_wrapper with synchronizers in aftx07_fpga
        datatype: bool
        paramtype: vlogdefine

    NOIP:
        description: Do not include IP blocks, used with SYNTHESIS flag during synthesis for design flow
        datatype: bool
        paramtype: vlogdefine

    QUARTUS:
        description: Indicates that Quartus synthesis is used, enables syntax workarounds
        datatype: bool
        paramtype: vlogdefine

