CAPI=2:
name: socet:aft:spi:0.1.0
description: spi modul

filesets:
    rtl:
        depend:
            - "socet:bus-components:bus_protocol_if"
        files:
            - include/apb_if.vh : { is_include_file : true }
            - include/spi_if.vh : { is_include_file : true }
            - include/spi_type_pkg.vh : { is_include_file : true }
            #- src/APB_SlaveInterface.sv
            - src/clock_divider.sv
            - src/clock_generator.sv
            - src/controller.sv
            - src/counters.sv
            - src/edge_detect_spi.sv
            - src/fifo.sv
            - src/flex_counter_spi.sv
            - src/flex_sr_spi.sv
            - src/interrupt_control.sv
            - src/sg.sv
            - src/sync_high.sv
            #- src/spi.sv
            - src/spi_wrapper.sv
        file_type: systemVerilogSource

    tb:
        files:
            - tb/tb_spi_wrapper.sv
        file_type: systemVerilogSource

targets:
    default: &default
        filesets:
            - rtl
        toplevel: spi_wrapper
    
    sim:
        <<: *default
        description: Simulate w/TB
        default_tool: xcelium 
        filesets_append:
            - tb
        toplevel: 
            - "!tool_verilator? (tb_spi_wrapper)"
            - "tool_verilator? (spi_wrapper)"
        tools:
            xcelium:
                xrun_options:
                    - +xmtimescale+1ns/100ps
            modelsim:
                vsim_options:
                    - -vopt
                    - -voptargs='+acc'
                    - -t ps
            vcs:
                vcs_options:
                    - -assert svaext
            verilator:
                verilator_options:
                    - --trace
                    - --trace-fst
                    - --trace-structs

    fpga:
        <<: *default
        description: Synthesize for FPGA
        default_tool: quartus
        toplevel:
            - spi_wrapper
        parameters:
            - NUM_PINS=8
            - SYNTHESIS=true
        tools:
            quartus:
                family: Cyclone IV E
                device: EP4CE115F29C7 
                

    lint:
        filesets:
            - lint_files
        description: Linting
        default_tool: veriblelint
        toplevel: tb_spi_wrapper
        tools:
            veriblelint:
                verible_lint_args: ['--autofix=inplace-interactive', '--rules_config_search']

    format:
        filesets:
            - lint_files
        description: Formatting
        default_tool: veribleformat
        toplevel: tb_spi_wrapper
        tools:
            veribleformat:
                verible_format_args: ['--indentation_spaces=4', '--inplace']

parameters:
    SYNTHESIS:
        datatype: bool
        paramtype: vlogdefine
