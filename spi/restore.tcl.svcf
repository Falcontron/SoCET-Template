# SimVision Command Script (Tue Nov 24 12:48:25 PM EST 2020)
#
# Version 15.20.s030
#
# You can restore this configuration with:
#
#      irun -access +rwc +nctimescale+1ns/1ps -incdir ./include src/APB_SlaveInterface.sv src/clock_divider.sv src/clock_generator.sv src/controller.sv src/counters.sv src/edge_detect_spi.sv src/fifo.sv src/flex_counter_spi.sv src/flex_sr_spi.sv src/interrupt_control.sv src/sg.sv src/spi.sv src/sync_high.sv tb/tb_spi.sv -input restore.tcl
#


#
# Preferences
#
preferences set toolbar-Standard-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-SimControl-WatchList {
  usual
  position -anchor e
}
preferences set plugin-enable-svdatabrowser-new 1
preferences set toolbar-Windows-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-sendToIndago-WaveWindow {
  usual
  position -pos 4
}
preferences set toolbar-Standard-Console {
  usual
  position -pos 1
}
preferences set toolbar-Search-Console {
  usual
  position -pos 2
}
preferences set toolbar-txe_waveform_toggle-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbar-SimControl-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-Windows-WaveWindow {
  usual
  position -pos 2
}
preferences set toolbar-Windows-WatchList {
  usual
  position -pos 2
}
preferences set whats-new-dont-show-at-startup 1
preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}

#
# Simulator
#
database require simulator -hints {
	simulator "irun -gui -access +rwc +nctimescale+1ns/1ps -incdir ./include src/APB_SlaveInterface.sv src/clock_divider.sv src/clock_generator.sv src/controller.sv src/counters.sv src/edge_detect_spi.sv src/fifo.sv src/flex_counter_spi.sv src/flex_sr_spi.sv src/interrupt_control.sv src/sg.sv src/spi.sv src/sync_high.sv tb/tb_spi.sv -input restore.tcl"
}

#
# Conditions
#
set expression {simulator::tb_spi.DUT.FIFO_RX.regs[31:0]}
if {[catch {condition new -name  RX_FIFO -expr $expression}] != ""} {
    condition set -using RX_FIFO -expr $expression
}
set expression {simulator::tb_spi.DUT.FIFO_TX.regs[9:0]}
if {[catch {condition new -name  TX_FIFO -expr $expression}] != ""} {
    condition set -using TX_FIFO -expr $expression
}
#
# Groups
#
catch {group new -name SPI_IF -overlay 0}
catch {group new -name APB_IF -overlay 0}
group using SPI_IF
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
     simulator::tb_spi.spiif.spi.SS_OUT  \
     simulator::tb_spi.spiif.spi.MISO_IN  \
     simulator::tb_spi.spiif.spi.MOSI_OUT  \
     simulator::tb_spi.spiif.spi.SCK_OUT  \
    {### cdivider} \
     simulator::tb_spi.spiif.spi.SS_IN  \
     simulator::tb_spi.spiif.spi.MISO_OUT  \
     simulator::tb_spi.spiif.spi.MOSI_IN  \
     simulator::tb_spi.spiif.spi.SCK_IN  \
     {simulator::tb_spi.spiif.spi.interrupts[5:0]}  \
     simulator::tb_spi.spiif.spi.mode 
group using APB_IF
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
     {simulator::tb_spi.apbif.apb_s.PADDR[31:0]}  \
     simulator::tb_spi.apbif.apb_s.PENABLE  \
     {simulator::tb_spi.apbif.apb_s.PRDATA[31:0]}  \
     simulator::tb_spi.apbif.apb_s.PSEL  \
     {simulator::tb_spi.apbif.apb_s.PWDATA[31:0]}  \
     simulator::tb_spi.apbif.apb_s.PWRITE 

#
# Mnemonic Maps
#
mmap new -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  simulator::tb_spi.DUT.FIFO_TX 
browser set \
    -signalsort name
browser yview see  simulator::tb_spi.DUT.FIFO_TX 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1920x971+0+31}] != ""} {
    window geometry "Waveform 1" 1920x971+0+31
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	simulator::tb_spi.DUT.CLK
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.nRST
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.test_block
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.test_num
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.tb_enable
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.tb_polarity
	} ]
set id [waveform add -cdivider divider]

set groupId0 [waveform add -groups APB_IF]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups SPI_IF]

set id [waveform add -cdivider divider]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.EN
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.SR.cstate[7:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.control_reg
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.status_reg
	} ]
waveform hierarchy expand $id
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.byte_length_reg[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.baud_rate_reg[31:0]}
	} ]
set id [waveform add -signals  {
	{TX_FIFO[9:0]}
	} ]
set id [waveform add -signals  {
	{RX_FIFO[31:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.op_complete
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.TX_REN
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.RX_WEN
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.counter_en
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.counter_rst
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.op_complete
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.shifter_en
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.shifter_load
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.shifter_rst
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.state
	} ]
set id [waveform add -signals  {
	simulator::tb_spi.DUT.CTRL.state_n
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.CG.count[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.CG.count_nxt[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.CG.divider[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.FIFO_TX.regs[31:0]}
	} ]
waveform hierarchy expand $id
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.FIFO_TX.rd_ptr[4:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.FIFO_TX.wr_ptr[4:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_spi.DUT.FIFO_TX.numdata[4:0]}
	} ]

waveform xview limits 111022499ps 422531000ps

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+550+642

#
# Layout selection
#

