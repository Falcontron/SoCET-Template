# ============================================================
# config.env for CI/CD template
# ============================================================
#
#   template sets variables for scripts below:
#
#   ./setup.sh
#   ./build.sh
#   ./test.sh
#   ./lint.sh
#   ./synth.sh
#
#   each script SHOULD work in each repo and then you can configure them in this config
#
#   for aftdev right now ci does
#
#   cd RISCVBusiness
#   python3 scripts/config_core.py ../aftx07.rvbcfg.yml
#   cd ..
#   ./generate-version-header.sh
#   fusesoc --cores-root . run --setup --build --build-root aft_out \
#       --target sim --tool verilator socet:aft:aftx07
#
#   and theyre all put into a docker toolchain image which is the following (for my username) and has:
#
#   ghcr.io/falcontron/socet-template-ci:latest
#
#   - FuseSoC
#   - Verilator
#   - Verible
#   - sv2v
#   - Yosys
#
# ============================================================


#   ok the rest is lowk ai annotated but i did read through it all to make sure its all in line


# ============================================================
# Project metadata
# ============================================================

# Human-readable project name used in script messages.
PROJECT_NAME="AFTx07"


# ============================================================
# Setup behavior
# ============================================================
#
# setup.sh prepares the repository before build/lint/synthesis.
# It should be safe to run locally and in CI.
# ============================================================

# Master enable/disable toggle for setup.sh.
# If set to 0, setup.sh should exit without doing setup work.
SETUP_ENABLED=1

# Initialize git submodules during setup.
#
# Set to 1 if the repo depends on submodules that must be initialized
# before build.
#
# For the current template test repo, submodule contents were copied into
# the repo, so this is disabled.
INIT_SUBMODULES=0

# Install external FuseSoC libraries listed in fusesoc_libraries.txt.
#
# AFTx07 needs the external PurdNyUart FuseSoC library for:
#   socet:purdnyuart:BaudRateGen
#   socet:purdnyuart:UartRxEn
#   socet:purdnyuart:UartTxEn
#
# fusesoc_libraries.txt should contain lines like:
#
#   purdnyuart https://github.com/NYU-Processor-Design/PurdNyUart.git <commit>
#
# setup.sh uses this file to generate fusesoc.conf and clone libraries
# into fusesoc_libraries/.
INSTALL_FUSESOC_LIBRARIES=1

# Apply patches listed in patches/patch_list.txt.
#
# Keep disabled unless the repo needs patch files applied during setup.
APPLY_PATCHES=0


# ============================================================
# Build behavior
# ============================================================
#
# build.sh performs the normal AFT Verilator build.
# ============================================================

# Master enable/disable toggle for build.sh.
BUILD_ENABLED=1


# ------------------------------------------------------------
# Build config step
# ------------------------------------------------------------
#
# This reproduces the original AFT command:
#
#   cd RISCVBusiness
#   python3 scripts/config_core.py ../aftx07.rvbcfg.yml
#
# This generates/configures the RISC-V core before the full AFT build.
# ------------------------------------------------------------

# Enable the RISC-V core configuration step.
CONFIG_STEP_ENABLED=1

# Directory to cd into before running the RISC-V config command.
RISCV_CONFIG_DIR="RISCVBusiness"

# Config script path relative to RISCV_CONFIG_DIR.
RISCV_CONFIG_SCRIPT="scripts/config_core.py"

# Config file path relative to RISCV_CONFIG_DIR.
RISCV_CONFIG_FILE="../aftx07.rvbcfg.yml"


# ------------------------------------------------------------
# Version header generation
# ------------------------------------------------------------
#
# This reproduces the original AFT command:
#
#   ./generate-version-header.sh
#
# The version header embeds git/version metadata used by the design.
# ------------------------------------------------------------

# Enable version header generation during build.sh.
VERSION_HEADER_ENABLED=1

# Script used to generate the version header.
GENERATE_VERSION_HEADER_SCRIPT="./generate-version-header.sh"


# ------------------------------------------------------------
# FuseSoC build
# ------------------------------------------------------------
#
# This reproduces the original AFT Verilator build:
#
#   fusesoc --cores-root . run --setup --build --build-root aft_out \
#       --target sim --tool verilator socet:aft:aftx07
# ------------------------------------------------------------

# Enable the main FuseSoC build.
FUSESOC_BUILD_ENABLED=1

# Optional fully custom FuseSoC build command.
#
# Leave empty to use the generic FuseSoC variables below.
# If set, build.sh can run this command instead of constructing the
# FuseSoC command from FUSESOC_CORE / FUSESOC_TARGET / etc.
FUSESOC_BUILD_CMD=""

# FuseSoC VLNV/core name for the AFT top-level design.
FUSESOC_CORE="socet:aft:aftx07"

# FuseSoC target. For the AFT simulation build, this is "sim".
FUSESOC_TARGET="sim"

# FuseSoC backend tool. In the open-source CI flow, this is Verilator.
FUSESOC_TOOL="verilator"

# FuseSoC build output directory.
FUSESOC_BUILD_ROOT="aft_out"

# Extra arguments appended to the FuseSoC command.
#
# AFT's original build.sh does not use extra arguments, so this stays empty.
FUSESOC_EXTRA_ARGS=""


# ------------------------------------------------------------
# Optional Xcelium FuseSoC build
# ------------------------------------------------------------
#
# The original AFT build.sh optionally built with Xcelium if xrun existed:
#
#   if hash xrun; then
#       fusesoc ... --tool xcelium ...
#   else
#       echo "No xrun, skipping xcelium build"
#   fi
#
# In open-source CI, Xcelium is unavailable, so this is disabled.
# ------------------------------------------------------------

# Enable optional Xcelium build.
XCELIUM_BUILD_ENABLED=0

# Optional fully custom Xcelium build command.
#
# Leave empty to use the generic Xcelium FuseSoC variables below.
XCELIUM_BUILD_CMD=""

# Xcelium FuseSoC tool name.
XCELIUM_TOOL="xcelium"

# Xcelium FuseSoC build output directory.
XCELIUM_BUILD_ROOT="aft_out_xcelium"

# Extra arguments appended to the Xcelium FuseSoC command.
XCELIUM_EXTRA_ARGS=""


# ------------------------------------------------------------
# Optional build hooks
# ------------------------------------------------------------
#
# These allow a repo to run extra commands before or after the normal build
# without editing build.sh.
# ------------------------------------------------------------

# Optional command run before the normal build flow.
PRE_BUILD_CMD=""

# Optional command run after the normal build flow.
POST_BUILD_CMD=""


# ============================================================
# Test behavior
# ============================================================
#
# test.sh is reserved for future AFT smoke/regression tests.
# Right now, AFT does not have a real automated test hooked into CI.
# ============================================================

# Master enable/disable toggle for test.sh.
TEST_ENABLED=1

# Test mode options:
#
#   command = run TEST_CMD directly
#   sim     = run SIM_BIN with timeout
#   none    = skip test
#
# Current mode uses a placeholder command.
TEST_MODE="command"

# Placeholder until AFT has a real regression/smoke test command.
TEST_CMD="echo 'AFT smoke test placeholder; replace with your real regression command when needed'"

# Simulator binary used only when TEST_MODE="sim".
SIM_BIN="./aft_out/socet_aft_aftx07_2.0.0/sim-verilator/Vaftx07"

# Timeout in seconds used only when TEST_MODE="sim".
TEST_TIMEOUT_SECONDS=60

# Optional regex used only when TEST_MODE="sim".
#
# If empty, a clean simulator exit is treated as enough.
# If set, test.sh can require this regex to appear in simulator output.
PASS_REGEX=""


# ============================================================
# Lint behavior
# ============================================================
#
# lint.sh currently runs Verible lint in CI.
#
# The lint workflow is advisory/non-blocking for now because the existing
# AFT codebase has many pre-existing style violations.
# ============================================================

# Master enable/disable toggle for lint.sh.
LINT_ENABLED=1

# Optional custom lint command.
#
# Leave empty to use the default Verible lint behavior in lint.sh.
# If set, lint.sh can run this command instead.
LINT_CMD=""


# ============================================================
# Synthesis behavior
# ============================================================
#
# synth.sh currently supports:
#
#   SYNTH_MODE="smoke"
#       Runs a small sv2v + Yosys synthesis check on socetlib_counter.
#       This proves the open-source synthesis toolchain works and uploads
#       synth_out/ artifacts in CI.
#
#   SYNTH_MODE="full"
#       Experimental full-chip AFT synthesis using the FuseSoC .eda.yml.
#       This is not currently the default because full-chip synthesis hits
#       sv2v/Yosys limitations in generated CSR/interface logic.
#
# Current synthesis output is generic Yosys statistics, not final
# FreePDK45-mapped area/power.
# ============================================================

# Master enable/disable toggle for synth.sh.
SYNTH_ENABLED=1

# Synthesis mode:
#
#   smoke = small known-good synthesis target
#   full  = experimental full-chip synthesis
SYNTH_MODE="smoke"

# Optional fully custom synthesis command.
#
# Leave empty to use the default logic in synth.sh.
# If set, synth.sh can run this command instead.
SYNTH_CMD=""

# Top module used by Yosys.
#
# In smoke mode, this is intentionally NOT the full AFT top.
# It is a small known-good module used to prove sv2v + Yosys works.
#
# For future full-chip synthesis, this would likely become:
#
#   SYNTH_TOP="aftx07"
SYNTH_TOP="socetlib_counter"

# Directory where synth.sh writes generated synthesis artifacts:
#
#   rtl_files.f
#   converted.v
#   synth.ys
#   synth_netlist.v
#   yosys.log
#   area_report.txt
SYNTH_OUT_DIR="synth_out"

# Optional source files or filelist for custom synthesis flows.
#
# Currently unused by the default smoke synthesis flow.
SYNTH_SRCS=""