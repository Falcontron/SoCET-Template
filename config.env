# ============================================================
# config.env for AFTx07
# ============================================================
# This file controls:
#   - setup.sh
#   - build.sh
#   - test.sh
#   - lint.sh
#   - synth.sh
#
# This config replaces the original AFT build flow:
#   cd RISCVBusiness
#   python3 scripts/config_core.py ../aftx07.rvbcfg.yml
#   ./generate-version-header.sh
#   fusesoc --cores-root . run --setup --build --build-root aft_out \
#       --target sim --tool verilator socet:aft:aftx07
#
# with:
#   ./build.sh
# ============================================================

PROJECT_NAME="AFTx07"

# ============================================================
# Setup behavior
# ============================================================

SETUP_ENABLED=1

# Set to 1 if setup.sh should initialize submodules.
# For AFT, keep 0 if you already ran the original setup flow.
INIT_SUBMODULES=0

# Set to 1 if setup.sh should install external FuseSoC libraries
# from fusesoc_libraries.txt.
INSTALL_FUSESOC_LIBRARIES=0

# Set to 1 if setup.sh should apply patches from patches/patch_list.txt.
APPLY_PATCHES=0

# ============================================================
# Build behavior
# ============================================================

BUILD_ENABLED=1

# ------------------------------------------------------------
# Config step
# ------------------------------------------------------------
# Replaces:
#   cd RISCVBusiness
#   python3 scripts/config_core.py ../aftx07.rvbcfg.yml

CONFIG_STEP_ENABLED=1
RISCV_CONFIG_DIR="RISCVBusiness"
RISCV_CONFIG_SCRIPT="scripts/config_core.py"
RISCV_CONFIG_FILE="../aftx07.rvbcfg.yml"

# ------------------------------------------------------------
# Version header generation
# ------------------------------------------------------------
# Replaces:
#   ./generate-version-header.sh

VERSION_HEADER_ENABLED=1
GENERATE_VERSION_HEADER_SCRIPT="./generate-version-header.sh"

# ------------------------------------------------------------
# Primary FuseSoC build
# ------------------------------------------------------------
# Replaces:
#   fusesoc --cores-root . run --setup --build --build-root aft_out \
#       --target sim --tool verilator socet:aft:aftx07

PRIMARY_BUILD_ENABLED=1
PRIMARY_BUILD_CMD=""

FUSESOC_CORE="socet:aft:aftx07"
FUSESOC_TARGET="sim"
FUSESOC_TOOL="verilator"
BUILD_ROOT="aft_out"

# Extra FuseSoC args.
# AFT original build.sh does not use extra args.
FUSESOC_EXTRA_ARGS=""

# ------------------------------------------------------------
# Optional secondary FuseSoC build
# ------------------------------------------------------------
# Equivalent to the original optional Xcelium block:
#   if hash xrun; then
#       fusesoc ... --tool xcelium ...
#   else
#       echo "No xrun, skipping xcelium build"
#   fi
#
# Keep disabled for local/open-source flow.
# Set SECONDARY_BUILD_ENABLED=1 to match original behavior exactly.

SECONDARY_BUILD_ENABLED=0
SECONDARY_BUILD_CMD=""
SECONDARY_FUSESOC_TOOL="xcelium"
SECONDARY_BUILD_ROOT="aft_out_xcelium"
SECONDARY_FUSESOC_EXTRA_ARGS=""

# Optional command hooks
PRE_BUILD_CMD=""
POST_BUILD_CMD=""

# ============================================================
# Test behavior
# ============================================================

TEST_ENABLED=1

# Options:
#   command = run TEST_CMD directly
#   sim     = run SIM_BIN with timeout
#   none    = skip test

TEST_MODE="command"

# Placeholder until AFT has a real regression/smoke test command.
TEST_CMD="echo 'AFT smoke test placeholder; replace with your real regression command when needed'"

# Used only when TEST_MODE="sim"
SIM_BIN="./aft_out/socet_aft_aftx07_2.0.0/sim-verilator/Vaftx07"
TEST_TIMEOUT_SECONDS=60

# Empty means clean simulator exit is enough
PASS_REGEX=""

# ============================================================
# Lint behavior
# ============================================================

LINT_ENABLED=1

# Placeholder/default lint command.
# You can replace this with the actual AFT lint target if one exists.
LINT_CMD=""

# ============================================================
# Synthesis behavior
# ============================================================

SYNTH_ENABLED=1
SYNTH_CMD=""

# AFT top module for synthesis. Adjust if the actual top module name differs.
SYNTH_TOP="aftx07"

# Source files or filelist for synthesis
SYNTH_SRCS=""